+package tools
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/NERVsystems/osmmcp/pkg/osm"
+	"github.com/mark3labs/mcp-go/mcp"
+)
+
+type placesRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f placesRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestNearbyCafeAlternativesAndBuildingCenter(t *testing.T) {
+	client := osm.GetClient(context.Background())
+	original := client.Transport
+	t.Cleanup(func() { client.Transport = original })
+	client.Transport = placesRoundTripFunc(func(req *http.Request) (*http.Response, error) {
+		body, _ := io.ReadAll(req.Body)
+		form, err := url.ParseQuery(string(body))
+		if err != nil {
+			t.Fatal(err)
+		}
+		query := form.Get("data")
+		var cafe, shop bool
+		for _, branch := range strings.Split(query, ";") {
+			hasCafe, hasShop := strings.Contains(branch, "[amenity"), strings.Contains(branch, "[shop")
+			if hasCafe && hasShop {
+				t.Fatalf("cafe wrongly required to also be a coffee shop: %s", branch)
+			}
+			cafe, shop = cafe || hasCafe, shop || hasShop
+		}
+		if !cafe || !shop {
+			t.Fatal("category alternatives missing")
+		}
+		if !strings.Contains(query, "out body center;") || strings.Contains(query, ">;") {
+			t.Fatalf("selected objects need their centers: %s", query)
+		}
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(`{"elements":[
+			{"type":"node","id":1,"lat":55.8105,"lon":37.4983,"tags":{"name":"Cafe","amenity":"cafe"}},
+			{"type":"way","id":2,"center":{"lat":55.811,"lon":37.499},"tags":{"name":"Building Cafe","amenity":"cafe"}}
+		]}`))}, nil
+	})
+	result, err := HandleFindNearbyPlaces(context.Background(), mcp.CallToolRequest{Params: mcp.CallToolParams{
+		Name: "find_nearby_places", Arguments: map[string]any{"latitude": 55.8104364, "longitude": 37.4983111, "radius": 700.0, "category": "cafe", "limit": 5.0},
+	}})
+	if err != nil || result.IsError {
+		t.Fatalf("handler failed: %v %+v", err, result)
+	}
+	var payload struct {
+		Places []Place `json:"places"`
+	}
+	if err := json.Unmarshal([]byte(result.Content[0].(mcp.TextContent).Text), &payload); err != nil {
+		t.Fatal(err)
+	}
+	if len(payload.Places) != 2 {
+		t.Fatalf("expected both cafes: %+v", payload)
+	}
+	building := payload.Places[1]
+	if building.Name != "Building Cafe" || building.Location.Latitude != 55.811 || building.Distance > 700 {
+		t.Fatalf("building center lost: %+v", building)
+	}
+}
