+package osm
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// Keep the logical service URL stable for the handlers, allow-list and metrics.
+// Only Overpass interpreter requests are routed to these fixed public mirrors.
+// POST bodies must be replayable; http.NewRequest supplies GetBody for the
+// strings.Reader bodies used by all Overpass handlers.
+type overpassTransport struct {
+	base      http.RoundTripper
+	endpoints []string
+	timeout   time.Duration
+}
+
+func newOverpassTransport(base http.RoundTripper) *overpassTransport {
+	return &overpassTransport{
+		base: base,
+		endpoints: []string{
+			"https://maps.mail.ru/osm/tools/overpass/api/interpreter",
+			OverpassBaseURL,
+		},
+		timeout: 35 * time.Second,
+	}
+}
+
+// SetOverpassEndpoint selects a supported upstream at startup, before any calls.
+// Regional mirrors must be selected explicitly because their coverage differs.
+func SetOverpassEndpoint(endpoint string) error {
+	if endpoint == "" {
+		return nil
+	}
+	switch endpoint {
+	case OverpassBaseURL,
+		"https://maps.mail.ru/osm/tools/overpass/api/interpreter",
+		"https://overpass.private.coffee/api/interpreter",
+		"https://ovp.dresel.systems/api/interpreter":
+	default:
+		return fmt.Errorf("unsupported Overpass endpoint: %s", endpoint)
+	}
+	t := httpClient.Transport.(*overpassTransport)
+	endpoints := []string{endpoint}
+	for _, existing := range t.endpoints {
+		if existing != endpoint {
+			endpoints = append(endpoints, existing)
+		}
+	}
+	t.endpoints = endpoints
+	return nil
+}
+
+type cancelBody struct {
+	io.ReadCloser
+	cancel context.CancelFunc
+}
+
+func (b *cancelBody) Close() error {
+	err := b.ReadCloser.Close()
+	b.cancel()
+	return err
+}
+
+func (t *overpassTransport) attempt(req *http.Request, endpoint string, timeout time.Duration) (*http.Response, error) {
+	ctx, cancel := context.WithTimeout(req.Context(), timeout)
+	clone := req.Clone(ctx)
+	if endpoint != "" {
+		u, err := url.Parse(endpoint)
+		if err != nil {
+			cancel()
+			return nil, err
+		}
+		clone.URL.Scheme, clone.URL.Host, clone.URL.Path = u.Scheme, u.Host, u.Path
+		clone.Host = ""
+		// Some public gateways handle POST more reliably than GET queries.
+		if clone.Method == http.MethodGet && clone.URL.Query().Get("data") != "" {
+			body := clone.URL.RawQuery
+			clone.Method = http.MethodPost
+			clone.URL.RawQuery = ""
+			clone.Body = io.NopCloser(strings.NewReader(body))
+			clone.ContentLength = int64(len(body))
+			clone.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		}
+	}
+	if req.Body != nil && req.Body != http.NoBody {
+		var err error
+		clone.Body, err = req.GetBody()
+		if err != nil {
+			cancel()
+			return nil, err
+		}
+	}
+	resp, err := t.base.RoundTrip(clone)
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	// Keep the attempt context alive while the caller decodes the response.
+	resp.Body = &cancelBody{ReadCloser: resp.Body, cancel: cancel}
+	return resp, nil
+}
+
+func (t *overpassTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.Body != nil && req.Body != http.NoBody && req.GetBody == nil {
+		// Do not replay an arbitrary streaming request.
+		return t.base.RoundTrip(req)
+	}
+	// The RoundTripper owns the original body even when sending cloned requests.
+	if req.Body != nil {
+		defer req.Body.Close()
+	}
+	if req.URL.Host != hostFromURL(OverpassBaseURL) || req.URL.Path != "/api/interpreter" {
+		return t.attempt(req, "", 30*time.Second)
+	}
+	var lastErr error
+	for i, endpoint := range t.endpoints {
+		if err := req.Context().Err(); err != nil {
+			return nil, err
+		}
+		resp, err := t.attempt(req, endpoint, t.timeout)
+		if err == nil {
+			retryable := resp.StatusCode == 429 || resp.StatusCode == 502 || resp.StatusCode == 503 || resp.StatusCode == 504
+			if !retryable || i == len(t.endpoints)-1 {
+				slog.Info("Overpass upstream response", "endpoint", endpoint, "status", resp.StatusCode)
+				return resp, nil
+			}
+			lastErr = fmt.Errorf("HTTP %d", resp.StatusCode)
+			resp.Body.Close()
+		} else {
+			lastErr = err
+		}
+		slog.Warn("Overpass upstream failed", "endpoint", endpoint, "error", lastErr)
+	}
+	return nil, fmt.Errorf("all Overpass upstreams failed: %w", lastErr)
+}
