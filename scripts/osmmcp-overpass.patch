+package osm
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+type overpassRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f overpassRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestOverpassFailoverReplaysQuery(t *testing.T) {
+	for _, status := range []int{429, 502, 503, 504} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			calls := 0
+			tr := newOverpassTransport(overpassRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				body, _ := io.ReadAll(r.Body)
+				if string(body) != "data=query" || r.Method != "POST" {
+					t.Fatalf("query lost: %s %s", r.Method, body)
+				}
+				wantHost := "maps.mail.ru"
+				if calls == 2 {
+					wantHost = "overpass-api.de"
+				}
+				if r.URL.Host != wantHost {
+					t.Fatalf("upstream = %s", r.URL.Host)
+				}
+				code := status
+				if calls == 2 {
+					code = 200
+				}
+				return &http.Response{StatusCode: code, Body: io.NopCloser(strings.NewReader(`{"elements":[]}`))}, nil
+			}))
+			req, _ := http.NewRequest("POST", OverpassBaseURL, strings.NewReader("data=query"))
+			resp, err := tr.RoundTrip(req)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer resp.Body.Close()
+			if calls != 2 || resp.StatusCode != 200 {
+				t.Fatalf("calls=%d status=%d", calls, resp.StatusCode)
+			}
+		})
+	}
+}
+
+func TestOverpassDoesNotRetryBadQuery(t *testing.T) {
+	calls := 0
+	tr := newOverpassTransport(overpassRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return &http.Response{StatusCode: 400, Body: http.NoBody}, nil
+	}))
+	req, _ := http.NewRequest("GET", OverpassBaseURL+"?data=bad", nil)
+	resp, err := tr.RoundTrip(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if calls != 1 || resp.StatusCode != 400 {
+		t.Fatalf("calls=%d", calls)
+	}
+}
+
+func TestOverpassNetworkTimeoutAndCancellation(t *testing.T) {
+	calls := 0
+	var responseContext context.Context
+	tr := newOverpassTransport(overpassRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		calls++
+		if calls == 1 {
+			<-r.Context().Done()
+			return nil, r.Context().Err()
+		}
+		responseContext = r.Context()
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("result"))}, nil
+	}))
+	tr.timeout = 10 * time.Millisecond
+	req, _ := http.NewRequest("GET", OverpassBaseURL+"?data=query", nil)
+	resp, err := tr.RoundTrip(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if responseContext.Err() != nil {
+		t.Fatal("response canceled before body read")
+	}
+	resp.Body.Close()
+	if responseContext.Err() == nil {
+		t.Fatal("attempt context not released")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = tr.RoundTrip(req.WithContext(ctx))
+	if !errors.Is(err, context.Canceled) || calls != 2 {
+		t.Fatalf("cancellation: calls=%d err=%v", calls, err)
+	}
+}
+
+func TestOverpassGETAndOtherServices(t *testing.T) {
+	tr := newOverpassTransport(overpassRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		if r.URL.Host == "maps.mail.ru" {
+			if r.Method != "POST" || r.URL.RawQuery != "" {
+				t.Fatal("GET query was not converted to POST")
+			}
+			body, _ := io.ReadAll(r.Body)
+			if string(body) != "data=query" {
+				t.Fatalf("query changed: %s", body)
+			}
+		} else if r.URL.String() != NominatimBaseURL+"/search?q=MAI" || r.Method != "GET" {
+			t.Fatalf("non-Overpass request modified: %s %s", r.Method, r.URL)
+		}
+		return &http.Response{StatusCode: 200, Body: http.NoBody}, nil
+	}))
+	for _, raw := range []string{OverpassBaseURL + "?data=query", NominatimBaseURL + "/search?q=MAI"} {
+		req, _ := http.NewRequest("GET", raw, nil)
+		resp, err := tr.RoundTrip(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp.Body.Close()
+	}
+}
