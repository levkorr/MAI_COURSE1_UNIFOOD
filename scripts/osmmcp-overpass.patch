+//go:build !windows
+
+package server
+
+import (
+	"os"
+	"syscall"
+)
+
+func isProcessRunning(pid int) bool {
+	if pid <= 0 {
+		return false
+	}
+	process, err := os.FindProcess(pid)
+	if err != nil {
+		return false
+	}
+	defer process.Release()
+	err = process.Signal(syscall.Signal(0))
+	return err == nil || err == syscall.EPERM
+}
